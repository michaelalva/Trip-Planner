			"name": "leoo: correctly sorts items in terms of distance",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "fe2238fb-91d7-461f-82f3-a52bce9b35a6",
						"exec": [
							"pm.test(\"Notes fields are in correct order\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    \r",
							"    const expectedOrder = [\"1st\", \"2nd\", \"3rd\"];\r",
							"\r",
							"    // Assume jsonData is an array of objects\r",
							"    const actualOrder = jsonData.places.map(obj => obj.notes);\r",
							"\r",
							"    pm.expect(actualOrder).to.eql(expectedOrder);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
