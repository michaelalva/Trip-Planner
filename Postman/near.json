		{
			"name": "duyalva: valid coordinates and limit",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "711b99c1-88b2-41ea-98c9-b36e7fbe2eb3",
						"exec": [
							"pm.test(\"Items (if array) are within distance and contain valid coordinates\", function () {",
							"    const jsonData = pm.response.json();",
							"    const isArray = Array.isArray(jsonData);",
							"    if (isArray) {",
							"        jsonData.forEach(place => {",
							"            pm.expect(place).to.have.property(\"latitude\");",
							"            pm.expect(place).to.have.property(\"longitude\");",
							"            const lat = parseFloat(place.latitude);",
							"            const lon = parseFloat(place.longitude);",
							"            pm.expect(lat).to.be.within(-90, 90);",
							"            pm.expect(lon).to.be.within(-180, 180);",
							"        });",
							"        pm.expect(jsonData.length).to.be.at.most(3);",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"id": "fb5c9b90-3076-4a25-abc2-38202d896d31",
