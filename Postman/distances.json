		{
			"name": "bryce24: distances checking array response",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "a1a8e2cb-efdb-4741-81a5-6c0a96b74832",
						"exec": [
							"//first check if http is okay",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"",
							"let response = pm.response.json();",
							"",
							"// Checking that the response has a 'distances' array",
							"pm.test(\"Response has 'distances' array\", function () {",
							"    pm.expect(response).to.have.property(\"distances\");",
							"    pm.expect(response.distances).to.be.an(\"array\");",
							"    pm.expect(response.distances.length).to.eql(4); // Expecting 4 results",
							"});",
							"",
							"//non negative number",
							"pm.test(\"Each distance is a valid non-negative number\", function () {",
							"    response.distances.forEach(distance => {",
							"        pm.expect(typeof distance).to.eql(\"number\");",
							"        pm.expect(distance).to.be.at.least(0);",
							"    });",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
