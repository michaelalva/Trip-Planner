		{
			"name": "duyalva: place has required properties",
			"event": [
				{
					"listen": "test",
					"script": {
						"id": "3872910f-b007-4911-a606-669ec7e40968",
						"exec": [
							"pm.test(\"Each place has required properties\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    if (jsonData.places.length > 0) {\r",
							"        const place = jsonData.places[0];\r",
							"        pm.expect(place).to.have.property(\"name\");\r",
							"        pm.expect(place).to.have.property(\"latitude\");\r",
							"        pm.expect(place).to.have.property(\"longitude\");\r",
							"    }\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
